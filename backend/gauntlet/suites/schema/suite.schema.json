{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GAUNTLET suite",
  "type": "object",
  "required": ["key", "scenarios", "personas"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "key": {"type": "string", "pattern": "^[a-z0-9_\\-]{1,64}$"},
    "name": {"type": "string", "maxLength": 120},
    "description": {"type": "string", "maxLength": 2000},
    "domain": {"type": "string", "maxLength": 200},
    "scenarios": {"type": "array", "minItems": 1, "maxItems": 100},
    "personas": {"type": "array", "minItems": 1, "maxItems": 20}
  }
}
