{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GAUNTLET scenario",
  "type": "object",
  "required": ["key", "coverage_tag", "objective", "goal_checklist", "opening_utterance", "fallback_lines"],
  "additionalProperties": false,
  "properties": {
    "key": {"type": "string", "pattern": "^[a-z0-9_\\-]{1,64}$"},
    "coverage_tag": {"enum": ["happy_path", "edge_case", "adversarial", "out_of_scope"]},
    "description": {"type": "string", "maxLength": 1000},
    "persona_key": {"type": "string"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 600},
    "goal_checklist": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "required": ["id", "text"], "additionalProperties": false,
        "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_\\-]{1,16}$"}, "text": {"type": "string", "minLength": 1, "maxLength": 300}}
      }
    },
    "opening_utterance": {"type": "string", "minLength": 1, "maxLength": 320},
    "fallback_lines": {"type": "array", "minItems": 2, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 320}},
    "interruption_lines": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "verify_line": {"type": "string", "maxLength": 320},
    "closing_line": {"type": "string", "maxLength": 320},
    "behaviour_policies": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "hesitation": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "pause_ms": {"type": "number", "minimum": 200, "maximum": 3000}}},
        "correction": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "after_turn": {"type": "integer", "minimum": 1, "maximum": 30}, "text": {"type": "string", "maxLength": 200}, "pause_ms": {"type": "number", "minimum": 200, "maximum": 3000}}},
        "extended_silence": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "silence_ms": {"type": "number", "minimum": 0, "maximum": 3000}}},
        "repetition": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "after_turn": {"type": "integer", "minimum": 1, "maximum": 30}}}
      }
    },
    "timing": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_turns": {"type": "integer", "minimum": 2, "maximum": 30},
        "max_duration_s": {"type": "integer", "minimum": 20, "maximum": 300},
        "turn_timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 20000}
      }
    },
    "chaos_profile_key": {"type": "string"},
    "success_criteria": {
      "type": "object", "additionalProperties": false,
      "properties": {"mode": {"enum": ["all_steps", "minimum_steps"]}, "minimum_steps": {"type": "integer", "minimum": 1, "maximum": 10}}
    }
  }
}
