# GAUNTLET environment template — names only. Real values live in platform secret stores (NFR-001).
# Copy to .env for local development. Every provider is optional in development: an absent provider
# degrades to its documented fallback (scripted caller lines, local synthesiser, no referee transcript).

# core
ENVIRONMENT=development          # development | staging | production
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DATABASE_URL=                    # empty in development = local SQLite at .data/gauntlet.db
REDIS_URL=                       # empty in development = in-process queue (API runs the worker too)
SECRET_ENCRYPTION_KEY=           # 32 bytes, base64, AES-256-GCM. Required outside development.

# auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# media
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# speech
SPEECHMATICS_API_KEY=
SPEECHMATICS_RT_URL=wss://eu2.rt.speechmatics.com/v2
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# inference (Groq, OpenAI-compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
CALLER_MODEL=openai/gpt-oss-20b
REFEREE_MODEL=openai/gpt-oss-120b

# storage (any S3-compatible provider; empty = local disk under .data/artifacts)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# limits and guards
MAX_CONCURRENT_CALLS=20
MAX_CALLS_PER_WORKER=4
MAX_CALLS_PER_RUN=200
MAX_RUN_DURATION_S=1800
DEFAULT_RUN_SPEND_CAP_USD=2.00
CALLER_LLM_TIMEOUT_MS=800
TURN_TIMEOUT_MS=8000
YIELD_TIMEOUT_MS=2000
DEAD_AIR_THRESHOLD_MS=1500
SPEECH_MARGIN_DB=12
CALIBRATION_MAX_ACCEPTABLE_MS=50
AUDIO_RETENTION_DAYS=7

# observability
LOG_LEVEL=INFO
